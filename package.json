{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:local": "node scripts/dev-local.mjs",
    "db:local": "node scripts/dev-local.mjs --setup",
    "preinstall": "node scripts/require-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:local": "node --test scripts/tests/dev-local.test.mjs scripts/tests/sqlite-local.test.mjs",
    "test:launcher": "node scripts/tests/launcher-smoke.mjs",
    "test:sqlite": "node scripts/test-sqlite.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
