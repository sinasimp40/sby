# Copy to .env.local on YOUR computer. Do not commit real values.
# PostgreSQL must already be installed/running, with an empty database for a new shop.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/telecart
SESSION_SECRET=
TELECART_OWNER_ID=local-admin
TELECART_ADMIN_EMAIL=admin@example.com
TELECART_ADMIN_INITIAL_PASSWORD=
# Initial default only. The dashboard's saved enable/disable choice takes precedence.
TELECART_TELEGRAM_DISABLED=true
