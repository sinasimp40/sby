# Reference only. start-local.bat or start-local.sh creates .env.local privately on your computer.
# Never commit real values. SQLite is created locally; no database server is required.
TELECART_SQLITE_PATH=data/telecart.db
SESSION_SECRET=
TELECART_OWNER_ID=local-admin
TELECART_ADMIN_EMAIL=admin@example.com
TELECART_ADMIN_INITIAL_PASSWORD=
# Initial default only. The dashboard's saved enable/disable choice takes precedence.
TELECART_TELEGRAM_DISABLED=true
