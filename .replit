modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
TELECART_ADMIN_EMAIL = "admin@admin.com"
TELECART_PUBLIC_URL = "https://sales-bot-dashboard.replit.app"

[userenv.development]
TELECART_ADMIN_EMAIL = "admin@admin.com"
TELECART_ALLOW_WORKSPACE_TESTING = "true"
TELECART_PUBLIC_URL = "https://72c90049-b1a9-4544-b4be-930592e9c024-00-39n4na8b9dd1l.pike.replit.dev"
TELECART_TELEGRAM_DISABLED = "true"

[nix]
channel = "stable-25_05"
