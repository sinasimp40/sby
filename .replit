modules = ["nodejs-20", "web", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
TELECART_ADMIN_EMAIL = "admin@admin.com"
TELECART_PUBLIC_URL = "https://sales-bot-dashboard.replit.app"

[userenv.development]
TELECART_ADMIN_EMAIL = "admin@admin.com"
TELECART_ALLOW_WORKSPACE_TESTING = "true"
TELECART_PUBLIC_URL = "https://c8462a00-1d36-4d97-aefc-4c882dc5ee51-00-24lqiojnd3mnp.pike.replit.dev"
TELECART_TELEGRAM_DISABLED = "true"
TELECART_ADMIN_ORIGIN = "https://c8462a00-1d36-4d97-aefc-4c882dc5ee51-00-24lqiojnd3mnp.pike.replit.dev"
TELECART_OWNER_ID = "local-8f1ba325-02da-4c00-a6b1-6263fa3c50c2"

[nix]
channel = "stable-25_05"
