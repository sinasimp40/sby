modules = ["web", "nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
TELECART_ADMIN_EMAIL = "admin@admin.com"
TELECART_PUBLIC_URL = "https://sbyone.replit.app"
TELECART_OWNER_ID = "local-8f1ba325-02da-4c00-a6b1-6263fa3c50c2"

[userenv.development]
TELECART_ADMIN_EMAIL = "admin@admin.com"
TELECART_ALLOW_WORKSPACE_TESTING = "true"
TELECART_PUBLIC_URL = "https://a9fdd597-eec3-4e2e-83fc-50bd06e95929-00-2fnsq8tir17yb.sisko.replit.dev"
TELECART_TELEGRAM_DISABLED = "true"
TELECART_ADMIN_ORIGIN = "https://a9fdd597-eec3-4e2e-83fc-50bd06e95929-00-2fnsq8tir17yb.sisko.replit.dev"
TELECART_OWNER_ID = "local-8f1ba325-02da-4c00-a6b1-6263fa3c50c2"
TELECART_SQLITE_PATH = "data/telecart.db"

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-6ef88930-eaec-49ee-98b9-58470dbc980d"
