modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
TELECART_ADMIN_EMAIL = "admin@admin.com"
TELECART_PUBLIC_URL = "https://sales-bot-dashboard.replit.app"

[userenv.development]
TELECART_ADMIN_EMAIL = "admin@admin.com"
TELECART_ALLOW_WORKSPACE_TESTING = "true"
TELECART_PUBLIC_URL = "https://8a5d8513-b2ee-4708-b038-5b489f58c347-00-3niahtrgjz82t.sisko.replit.dev"
TELECART_TELEGRAM_DISABLED = "false"

[nix]
channel = "stable-25_05"
